    {
      "id": "CecQPKPLGD4YWmWvlbRq6",
      "type": "text",
      "x": -432.5374722853335,
      "y": 71759.28247617855,
      "width": 2125.725198253551,
      "height": 1755,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",

    {
      "id": "qBWztIFJrMweKksF2kTQZ",
      "type": "text",
      "x": -515.5369546806953,
      "y": 56163.47476454553,
      "width": 2034.1385409628028,
      "height": 967.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0",

      "locked": false,
      "text": "Suppose your input is:\n1 2 3 5 4",
      "fontSize": 43,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Suppose your input is:\n1 2 3 5 4",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "W3rBoHGOa3GGPL9prZk3q",
      "type": "text",
      "x": -111.2461646507677,
      "y": 60695.21639480038,
      "width": 756.7998657226562,
      "height": 752.5,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 808051646,
      "version": 220,
      "versionNonce": 626361442,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1745820154736,
      "link": null,
      "locked": false,
      "text": "for(i=0;i<n;i++)\n{\n     set flag=0;\n   for(j=0;j<n-i-1;j++)\n    {\n        if(a[j]>a[j+1])\n        {\n            swap a[j] and a[j+1]\n              set flag=1;   \n        }\n        if(flag==0)\n            exit\n    }\n}",
      "fontSize": 43,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for(i=0;i<n;i++)\n{\n     set flag=0;\n   for(j=0;j<n-i-1;j++)\n    {\n        if(a[j]>a[j+1])\n        {\n            swap a[j] and a[j+1]\n              set flag=1;   \n        }\n        if(flag==0)\n            exit\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {

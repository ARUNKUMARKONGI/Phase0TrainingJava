      "index": "b14",
      "roundness": null,
      "seed": 2065156706,
      "version": 124,
      "versionNonce": 1890456894,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1745833864603,
      "link": null,
      "locked": false,
      "text": "void quicksort(int a[],int left, int right)\n{\nint pivot,temp,i,j; \nif(left<right)\n{\npivot=a[left];\ni=left;\nj=right; \nwhile(i<j)\n{\n        while(a[i]<=pivot&&i<=right)\n                i++;\n        while(a[j]>pivot)\n                j--;\n        if(i<j)\n        {\n        temp=a[i];\n        a[i]=a[j];\n        a[j]=temp;\n        }\n}\ntemp=a[left]; \na[left]=a[j];\na[j]=temp;\n\nquicksort(a,left,j-1); \nquicksort(a,j+1,right);",
      "fontSize": 52,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void quicksort(int a[],int left, int right)\n{\nint pivot,temp,i,j; \nif(left<right)\n{\npivot=a[left];\ni=left;\nj=right; \nwhile(i<j)\n{\n        while(a[i]<=pivot&&i<=right)\n                i++;\n        while(a[j]>pivot)\n                j--;\n        if(i<j)\n        {\n        temp=a[i];\n        a[i]=a[j];\n        a[j]=temp;\n        }\n}\ntemp=a[left]; \na[left]=a[j];\na[j]=temp;\n\nquicksort(a,left,j-1); \nquicksort(a,j+1,right);",
      "autoResize": false,
      "lineHeight": 1.25
    }
  ],
